{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Content Artifact",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "content_markdown"],
        "properties": {
          "heading": {"type": "string"},
          "content_markdown": {"type": "string", "minLength": 50},
          "key_terms": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "content": {"type": "string"}}}},
          "citations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "word_count": {"type": "integer", "minimum": 100},
    "reading_time_minutes": {"type": "number"}
  }
}
