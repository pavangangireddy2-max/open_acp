{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide Deck Artifact",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "content_points", "speaker_notes"],
        "properties": {
          "slide_number": {"type": "integer"},
          "title": {"type": "string"},
          "content_points": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "speaker_notes": {"type": "string", "minLength": 20},
          "visual_description": {"type": "string"},
          "layout": {"type": "string", "enum": ["title", "content", "two_column", "image_left", "image_right", "full_image", "section_break"]}
        }
      }
    },
    "total_slides": {"type": "integer", "minimum": 3},
    "estimated_duration_minutes": {"type": "number"}
  }
}
