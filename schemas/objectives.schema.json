{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objectives Artifact",
  "type": "object",
  "required": ["objectives"],
  "properties": {
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "bloom_level"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string", "minLength": 10},
          "bloom_level": {"type": "string", "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]},
          "skill_ids": {"type": "array", "items": {"type": "string"}},
          "assessment_method": {"type": "string"}
        }
      }
    },
    "coverage_matrix": {
      "type": "object",
      "description": "Maps each objective to the sections that address it"
    }
  }
}
