{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept Session Outline",
  "type": "object",
  "required": ["sections", "teaching_flow", "prerequisite_check", "total_estimated_minutes"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "purpose", "estimated_minutes", "bloom_level", "teaching_mode", "objective_ids"],
        "properties": {
          "heading": {"type": "string", "minLength": 3},
          "purpose": {"type": "string", "minLength": 20},
          "estimated_minutes": {"type": "number", "minimum": 3},
          "bloom_level": {"type": "string", "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]},
          "teaching_mode": {"type": "string", "enum": ["motivation", "prior_knowledge_bridge", "concept_explain", "worked_example", "guided_practice", "reflection_summary"]},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "subsections": {"type": "array", "items": {"type": "string", "minLength": 2}}
        }
      }
    },
    "teaching_flow": {"type": "string", "minLength": 30},
    "prerequisite_check": {"type": "string", "minLength": 10},
    "total_estimated_minutes": {"type": "number", "minimum": 15}
  }
}
