{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Session Outline",
  "type": "object",
  "required": ["sections", "teaching_flow", "project_specification", "architecture_overview", "total_estimated_minutes"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "purpose", "estimated_minutes", "bloom_level", "teaching_mode", "milestone", "deliverable", "dependencies", "objective_ids"],
        "properties": {
          "heading": {"type": "string", "minLength": 3},
          "purpose": {"type": "string", "minLength": 20},
          "estimated_minutes": {"type": "number", "minimum": 3},
          "bloom_level": {"type": "string", "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]},
          "teaching_mode": {"type": "string", "enum": ["project_context", "concept_explain", "architecture_reasoning", "guided_build", "verification_checkpoint", "integration_demo", "reflection_summary"]},
          "milestone": {"type": "string", "minLength": 2},
          "deliverable": {"type": "string", "minLength": 10},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "teaching_flow": {"type": "string", "minLength": 30},
    "project_specification": {"type": "string", "minLength": 20},
    "architecture_overview": {"type": "string", "minLength": 20},
    "total_estimated_minutes": {"type": "number", "minimum": 20}
  }
}
