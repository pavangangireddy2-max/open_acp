{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Session Core Content",
  "type": "object",
  "required": ["sections", "word_count", "reading_time_minutes"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "teaching_mode", "objective_ids", "content_markdown", "architecture_context", "verification_step", "integration_points"],
        "properties": {
          "heading": {"type": "string", "minLength": 3},
          "teaching_mode": {"type": "string", "enum": ["project_context", "concept_explain", "architecture_reasoning", "guided_build", "verification_checkpoint", "integration_demo", "reflection_summary"]},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "content_markdown": {"type": "string", "minLength": 300},
          "architecture_context": {"type": "string", "minLength": 20},
          "files_created": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "setup_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verification_step": {"type": "string", "minLength": 10},
          "integration_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
          "key_terms": {"type": "array", "items": {"type": "string", "minLength": 2}}
        }
      }
    },
    "word_count": {"type": "integer", "minimum": 1200},
    "reading_time_minutes": {"type": "number", "minimum": 6}
  }
}
