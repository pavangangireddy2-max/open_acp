{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept Session Core Content",
  "type": "object",
  "required": ["sections", "word_count", "reading_time_minutes"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "teaching_mode", "objective_ids", "content_markdown", "key_terms", "examples"],
        "properties": {
          "heading": {"type": "string", "minLength": 3},
          "teaching_mode": {"type": "string", "enum": ["motivation", "prior_knowledge_bridge", "concept_explain", "worked_example", "guided_practice", "reflection_summary"]},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "content_markdown": {"type": "string", "minLength": 400},
          "key_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "content"],
              "properties": {
                "title": {"type": "string", "minLength": 3},
                "content": {"type": "string", "minLength": 20}
              }
            }
          },
          "misconceptions": {"type": "array", "items": {"type": "string", "minLength": 5}},
          "bridge_to_next": {"type": "string", "minLength": 10},
          "citations": {"type": "array", "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "word_count": {"type": "integer", "minimum": 1200},
    "reading_time_minutes": {"type": "number", "minimum": 6}
  }
}
